# Viewer only. These are not FETCH API credentials.
VIEWER_ORIGIN=https://viewer.example.org
VIEWER_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# post for Entra, basic for Cognito clients with a secret.
OIDC_CLIENT_AUTH=post
# Keys in viewers are OIDC sub claims, not email addresses or Entra object IDs.
# Content requires both allowContent here AND content capture at emission time.
VIEWER_CONFIG_JSON={"scopes":{"school/test/test-key":{"clientId":"school","environment":"test","keyId":"test-key","allowContent":false,"source":{"kind":"azure","workspaceId":"00000000-0000-0000-0000-000000000000"}}},"viewers":{"REPLACE_WITH_OIDC_SUBJECT":["school/test/test-key"]}}
