# Local development; change ENV and configure API_CREDENTIALS before deployment.
ENV=production
OFFLINE_MODE=1
API_TOKENS=
API_TOKEN_CLIENT_IDS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_GPT_5_2_API_KEY=
OPENAI_GPT_5_2_MODEL=gpt-5.2
OPENAI_MISTRAL_MODEL=mistral-small-2503
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TELEMETRY_ENABLED=false
TELEMETRY_CAPTURE_FULL_QUERY=false
TELEMETRY_CONTENT_CLIENT_IDS=
TELEMETRY_ISOLATED_CLIENT_IDS=
TELEMETRY_AZURE_CLIENT_CONNECTION_STRINGS={}
AZURE_MONITOR_CONNECTION_STRING=

# Optional portable OpenAI-compatible backend (including Amazon Bedrock).
# Leave FETCH_ENABLED_PROVIDERS unset to retain the original ensemble.
# FETCH_ENABLED_PROVIDERS=compatible,keyword
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
AWS_REGION=us-east-1

# Generic dashboard. Dedicated review credentials, separate from API tokens.
DASHBOARD_ENABLED=false
DASHBOARD_STORAGE=sqlite
DASHBOARD_SQLITE_PATH=private-data/activity.sqlite3
DASHBOARD_TOKEN_CLIENT_IDS=
DASHBOARD_CAPTURE_CONTENT=false
DASHBOARD_RETENTION_DAYS=30
# Set when DASHBOARD_STORAGE=dynamodb:
DASHBOARD_TABLE=

# Portable OpenTelemetry. Azure direct or OTLP/HTTP to an AWS/other collector.
TELEMETRY_EXPORTER=
TELEMETRY_LOGS_ENABLED=false
TELEMETRY_SERVICE_NAME=fetch
TELEMETRY_ENVIRONMENT=
TELEMETRY_CLIENT_DESTINATIONS={}
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Trusted consumer/environment/key identity. See docs/CREDENTIAL_SCOPES.md.
# API_CREDENTIALS={"host-prod":{"client_id":"host","environment":"production","token_env":"API_KEY_PRODUCTION","capture_content":false},"host-test":{"client_id":"host","environment":"test","token_env":"API_KEY_TEST","capture_content":false}}
API_CREDENTIALS={}
API_KEY_PRODUCTION=
API_KEY_TEST=
# Routes must use full consumer/environment/key IDs. No shared fallback.
TELEMETRY_SCOPE_DESTINATIONS={}

# Recommended portable ensemble: Terra + Haiku (see docs/MODEL_HOSTING.md).
# Requires the named endpoint registry and credentials documented there.
# FETCH_ENABLED_PROVIDERS=terra,haiku
# FETCH_MERGE_MODEL=terra
# FETCH_AUXILIARY_MODEL=haiku
