{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Optional persistent FETCH dashboard activity storage for Fly.io or other hosts",
  "Resources": {
    "Activity": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "client_id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sort_key",
            "AttributeType": "S"
          },
          {
            "AttributeName": "session_key",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "client_id",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sort_key",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "sessions",
            "KeySchema": [
              {
                "AttributeName": "session_key",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "sort_key",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
    "TableName": {
      "Value": {
        "Ref": "Activity"
      }
    },
    "TableArn": {
      "Value": {
        "Fn::GetAtt": [
          "Activity",
          "Arn"
        ]
      }
    }
  }
}
